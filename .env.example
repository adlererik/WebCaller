HOST=127.0.0.1
PORT=8088
PUBLIC_URL=https://calls-test.example.com/calls
# Optional old paths on this SAME origin. Leave empty for a new installation.
APP_PATH_ALIASES=
# During a path move, keep the original manifest ID, e.g. /calls/ (not a secret).
APP_MANIFEST_ID=
DATA_DIR=./data
# Required only by this experimental branch. Use an independent origin/database.
WEBCALLER_TEST_INSTANCE=libsignal-preview-v1
# Generate with: npm run setup
BOOTSTRAP_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Cloudflare Realtime TURN (a separate product from Tunnel):
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Or your public coturn relay, DNS-only, with the same REST shared secret:
TURN_URLS=
TURN_SECRET=
# External TLS port; 443 needs a separate plan when another website already uses it.
TURN_TLS_PORT=5349
# Example TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp

# Docker / guided installer
WEB_HOST=calls.example.com
APP_PORT=8088
TURN_PUBLIC_IP=
TURN_LAN_IP=
TURN_REALM=webcaller
# Expiring encrypted file storage quotas; each file is limited to 200 MB.
ATTACHMENT_USER_QUOTA_MB=1024
ATTACHMENT_GLOBAL_QUOTA_MB=4096

# Optional public map tile template. No key is needed for the default preview.
# This URL is visible in browsers; never include private credentials.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# Optional extra ringing. Use a separate self-hosted ntfy origin; see docs/EXTRA_RINGING.md.
# All three below must be set together. Leave blank to use only normal Web Push.
NTFY_PUBLIC_URL=
NTFY_PUBLISH_URL=
NTFY_PUBLISH_TOKEN=
# true only if ntfy upstream-base-url is configured for the stock iPhone client.
NTFY_IOS_UPSTREAM=false

# Prebuilt Docker only: use its isolated publisher volume and exact internal hostname.
NTFY_PUBLISH_TOKEN_FILE=
NTFY_ALLOW_DOCKER_HTTP=false

# Optional public calling codes; devices remain unlisted until they choose one.
DIAL_CODES_ENABLED=true
