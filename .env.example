HOST=127.0.0.1
PORT=8080
PUBLIC_URL=https://calls.example.com/calls
DATA_DIR=./data
# Generate with: npm run setup
BOOTSTRAP_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Cloudflare Realtime TURN (a separate product from Tunnel):
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Or your public coturn relay, DNS-only, with the same REST shared secret:
TURN_URLS=
TURN_SECRET=
# External TLS port; 443 needs a separate plan when another website already uses it.
TURN_TLS_PORT=5349
# Example TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp

# Docker / guided installer
WEB_HOST=calls.example.com
APP_PORT=8080
TURN_PUBLIC_IP=
TURN_LAN_IP=
TURN_REALM=webcaller
# Expiring encrypted file storage quotas; each file is limited to 10 MB.
ATTACHMENT_USER_QUOTA_MB=100
ATTACHMENT_GLOBAL_QUOTA_MB=1024

# Optional public map tile template. No key is needed for the default preview.
# This URL is visible in browsers; never include private credentials.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
