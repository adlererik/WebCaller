FROM debian:13-slim
RUN apt-get update && apt-get install -y --no-install-recommends coturn python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY deploy/turnserver.conf.example /etc/webcaller-turn.template
COPY deploy/turn-container.py /usr/local/bin/webcaller-turn.py
ENTRYPOINT ["python3", "/usr/local/bin/webcaller-turn.py"]
