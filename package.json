{
  "name": "webcaller",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "audit:source": "node scripts/audit-source.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7",
    "ws": "8.21.0"
  },
  "description": "Web-only adaptive audio/video calls and encrypted disappearing messages",
  "license": "MIT",
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "vodozemac-legacy-test": "npm:@towns-protocol/vodozemac@0.1.0"
  }
}
